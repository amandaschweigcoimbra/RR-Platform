# Database
DATABASE_URL=sqlite+aiosqlite:///./rrp.db

# Anthropic / Claude
# For local dev via SAP proxy:
# ANTHROPIC_BASE_URL=http://localhost:6655/anthropic
# ANTHROPIC_AUTH_TOKEN=placeholder
#
# For cloud / production — use a real Anthropic API key:
ANTHROPIC_API_KEY=sk-ant-...
AI_DEFAULT_MODEL=claude-sonnet-4-5
AI_FAST_MODEL=claude-haiku-4-5-20251001

# SharePoint / Microsoft Graph
# For local dev — reads token from ~/.sap-mcp/auth.json automatically.
# For cloud / production — paste a valid Graph token here (re-paste when it expires ~1h),
# OR set up a service principal and set GRAPH_CLIENT_ID, GRAPH_CLIENT_SECRET, GRAPH_TENANT_ID.
GRAPH_TOKEN=

SAP_MCP_AUTH_FILE=C:/Users/YOUR_I_NUMBER/.sap-mcp/auth.json
SHAREPOINT_SITE=sap.sharepoint.com:/sites/208727
SHAREPOINT_LIST_NAME=Release Readiness Intake and Program Tracker (Public)
PROGRAM_LEAD_FILTER=Coimbra, Amanda
